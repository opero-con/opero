  "message": "<p>Hello {{ doc.custom_pm_name or \"Project Manager\" }},</p>\r\n\r\n<p>A travel request for your project <strong>{{ doc.custom_project_name }}</strong> is now <strong>Pending Approval</strong>.</p>\r\n\r\n<p><strong>Details:</strong></p>\r\n<ul>\r\n    <li><strong>Traveller:</strong> {{ doc.employee_name }}</li>\r\n    <li><strong>Status:</strong> {{ doc.workflow_state or \"N/A\" }}</li>\r\n    <li><strong>Created On:</strong> {{ frappe.utils.format_datetime(doc.creation, \"yyyy-MM-dd HH:mm\") }}</li>\r\n    <li><strong>Submitted By:</strong> {{ doc.modified_by }}</li>\r\n</ul>\r\n\r\n<p>Please review and take the necessary action at your earliest convenience, \r\n<a href=\"{{ frappe.utils.get_url() }}/app/form/{{ doc.doctype | replace(' ', '%20') }}/{{ doc.name }}\">here</a>.</p>\r\n",
  "attach_print": 0,
  "print_format": null,
  "message_type": "Markdown",
  "attach_files": null,
  "from_attach_field": null,
  "notification_type": "Alert",
