 {
  "name": "Travel Request Approval - Review Details",
  "idx": 0,
  "enabled": 1,
  "channel": "Email",
  "slack_webhook_url": null,
  "subject": "Travel Request Approval - Review Details",
  "document_type": "Travel Request",
  "is_standard": 0,
  "module": "Opero",
  "event": "Save",
  "method": null,
  "date_changed": null,
  "days_in_advance": 0,
  "value_changed": null,
  "sender": "Opero Info",
  "send_system_notification": 1,
  "sender_email": "opero@cubenet.systems",
  "condition": "doc.workflow_state == \"Approved\" and doc.custom_previous_workflow_state == \"Pending PM's Approval\" and doc.creation != doc.modified\n",
  "set_property_after_alert": null,
  "property_value": null,
  "send_to_all_assignees": 0,
  "message": "<p><strong>Travel request</strong> has been approved.</p>\r\n\r\n<p><strong>Details:</strong></p>\r\n<ul>\r\n    <li><strong>Project:</strong> {{ doc.custom_project_name }}</li>\r\n    <li><strong>Traveller:</strong> {{ doc.employee_name }}</li>\r\n    <li><strong>Status:</strong> {{ doc.workflow_state or \"N/A\" }}</li>\r\n    <li><strong>Approved On:</strong> {{ frappe.utils.format_datetime(doc.modified or frappe.utils.now(), \"yyyy-MM-dd HH:mm\") }}</li>\r\n    <li><strong>Approved By:</strong> {{ doc.modified_by }}</li>\r\n</ul>\r\n\r\n<p>Please take neccessary actions at your earliest, \r\n<a href=\"{{ frappe.utils.get_url() }}/app/form/{{ doc.doctype | replace(' ', '%20') }}/{{ doc.name }}\">here</a>.</p>\r\n",
  "attach_print": 0,
  "print_format": null,
  "message_type": "Markdown",
  "attach_files": null,
  "from_attach_field": null,
  "notification_type": "Alert",
  "notification_title": null,
  "notification_message": "{{ doc.employee_name }} · {{ doc.custom_project_name }} · {{ doc.workflow_state or \"Approved\" }}",
  "recipients": [
   {
    "idx": 1,
    "receiver_by_document_field": null,
    "receiver_by_role": "Expense Approver",
    "cc": null,
    "bcc": null,
    "condition": null,
    "parentfield": "recipients",
    "parenttype": "Notification",
    "doctype": "Notification Recipient"
   }
  ],
  "doctype": "Notification"
 },
 {
